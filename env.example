# ─────────────────────────────────────────
# YANTRA NEGÓCIOS IMOBILIÁRIOS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# NUNCA commite o .env.local no git
# ─────────────────────────────────────────

# ── Sanity CMS ────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=           # Ex: abc123de
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=                        # Token com permissão de leitura/escrita

# ── WhatsApp ──────────────────────────────
# Formato: código do país + DDD + número (sem espaços ou símbolos)
NEXT_PUBLIC_WHATSAPP_NUMBER=5519999999999

# ── Google Maps ───────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=             # Habilitar: Maps Embed API + Maps JavaScript API

# ── Email (Resend) ────────────────────────
# Criar conta gratuita em resend.com
RESEND_API_KEY=                          # Ex: re_xxxxxxxxxx
RESEND_FROM_EMAIL=contato@yantraimoveis.com.br
RESEND_TO_EMAIL=contato@yantraimoveis.com.br

# ── Site ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yantraimoveis.com.br
